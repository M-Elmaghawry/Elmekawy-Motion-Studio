  "prompts": [
    {
      "id": "prompt-before",
      "title": "Coordination before",
      "text": "Create an original synthetic BIM coordination concept illustration, not a real\nengineering project. Orthographic isometric view of one simple structural bay,\nthree translucent concrete beams, one pale blue horizontal service route and one\nwarm amber service route visibly crossing at the center. Clean simplified CAD\ngeometry, premium dark navy background #003060 fading to #030D1B, cyan #0E86D4\nand light blue #68BBE3 accents, restrained illumination. Center the geometry in\nthe middle 70 percent, generous clear space at top and bottom for labels added\nlater. Landscape 6:5. No text. Keep the camera, framing and structure suitable\nfor a matched before and after concept pair.",
      "negativeConstraints": "No text, logos, watermark, real project identifiers or engineering verification claims.",
      "sceneIds": [
        "comparison"
      ],
      "status": "ready-to-copy"
    },
    {
      "id": "prompt-after",
      "title": "Coordination after",
      "text": "Using my supplied synthetic BEFORE coordination concept as a reference, preserve\nthe exact orthographic isometric camera, crop, structural bay, beams, materials,\nlighting and navy background. Change only the warm amber service route into a\ncyan illustrative offset route around the central intersection, with visibly\nseparated routes. This is conceptual visualization only, not engineering\nvalidation. Premium restrained dark tech illustration, simple clear geometry,\nsame empty top and bottom margins, landscape 6:5. No text or annotations.",
      "negativeConstraints": "No text, logos, watermark, real project identifiers or engineering verification claims.",
      "sceneIds": [
        "comparison"
      ],
      "status": "ready-to-copy"
    }
  ]
