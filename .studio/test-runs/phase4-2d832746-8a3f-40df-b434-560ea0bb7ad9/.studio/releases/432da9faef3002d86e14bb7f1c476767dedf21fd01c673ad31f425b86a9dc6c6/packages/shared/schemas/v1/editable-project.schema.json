{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:elmekawy:editable-project:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "brief",
    "script",
    "scenes",
    "prompts",
    "crf"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "description",
        "objective",
        "category",
        "audience",
        "platforms"
      ],
      "properties": {
        "client": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "objective": {
          "type": "string",
          "maxLength": 10000
        },
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "audience": {
          "type": "string",
          "maxLength": 1000
        },
        "platforms": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "notes"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 50000
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "scenes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "content": {
            "type": "object",
            "maxProperties": 100,
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            },
            "propertyNames": {
              "maxLength": 200
            }
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text",
          "negativeConstraints",
          "sceneIds",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          },
          "negativeConstraints": {
            "type": "string",
            "maxLength": 5000
          },
          "sceneIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "status": {
            "enum": [
              "draft",
              "ready-to-copy",
              "uploaded",
              "approved"
            ]
          }
        }
      }
    },
    "crf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 51
    }
  }
}
